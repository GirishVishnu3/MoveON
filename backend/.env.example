# ============================================================
# MoveON Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file — only .env.example is committed.
# ============================================================

# ── Database ────────────────────────────────────────────────
# SQLite (default — no setup required for local development):
DATABASE_URL=sqlite+aiosqlite:///./moveon.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/moveon

# ── Security ────────────────────────────────────────────────
# Must be a long random string. Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-long-random-secret

# ── SMS / OTP Provider ──────────────────────────────────────
#
# SMS_PROVIDER controls which OTP provider is used.
#
# LOCAL (default):
#   No SMS is sent. OTP is written to the SERVER LOG ONLY.
#   Use for local development and automated tests.
#   The OTP is never returned to any API client in any mode.
SMS_PROVIDER=LOCAL
#
# TWILIO_VERIFY (production):
#   Twilio Verify sends a real SMS to the user's phone.
#   Twilio manages OTP generation and validation — we never see or store the code.
#   OTPs expire after 10 minutes. Max 5 incorrect attempts per code.
#
#   Setup steps:
#     1. Create a free Twilio account at https://www.twilio.com/try-twilio
#     2. Get your Account SID + Auth Token from https://console.twilio.com
#     3. Create a Verify Service at https://console.twilio.com/us1/verify/services
#        (type: SMS, friendly name: MoveON)
#     4. Copy the Service SID (starts with VA...)
#     5. Set the four variables below and change SMS_PROVIDER to TWILIO_VERIFY
#
# SMS_PROVIDER=TWILIO_VERIFY
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_32_char_auth_token_here
# TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
