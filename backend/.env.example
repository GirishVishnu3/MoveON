# ============================================================
# MoveON Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file — only .env.example is committed.
# ============================================================

# ── Database ────────────────────────────────────────────────
# SQLite (default — no setup required for local development):
DATABASE_URL=sqlite+aiosqlite:///./moveon.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/moveon

# ── Security ────────────────────────────────────────────────
# Must be a long random string. Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-long-random-secret

# ── Firebase Authentication ─────────────────────────────────
# We use Firebase Phone Authentication to verify users.
# The frontend requests the OTP and sends the Firebase ID token here.
#
# Obtain your service account JSON from:
# Firebase Console > Project Settings > Service Accounts > Generate new private key
# 
# Stringify the entire JSON file and paste it here on a single line:
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
