# ============================================================
# MoveON Backend Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Database
# SQLite (default for local dev - no setup needed):
DATABASE_URL=sqlite+aiosqlite:///./moveon.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@host/dbname

# Security
SECRET_KEY=your-secure-random-secret-key-change-this

# ============================================================
# SMS Provider Configuration
# ============================================================
#
# DEV mode (default): OTP is printed to logs & returned in API response.
# No real SMS is sent. Use this for local development.
SMS_PROVIDER=DEV

# --- Option 1: Twilio (international, paid) ---
# Sign up at https://www.twilio.com/try-twilio
# Set SMS_PROVIDER=TWILIO and fill in the 3 vars below:
# SMS_PROVIDER=TWILIO
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+14155238886

# --- Option 2: Fast2SMS (India only, free tier available) ---
# Sign up at https://www.fast2sms.com
# Set SMS_PROVIDER=FAST2SMS and fill in the var below:
# SMS_PROVIDER=FAST2SMS
# FAST2SMS_API_KEY=your_fast2sms_api_key
